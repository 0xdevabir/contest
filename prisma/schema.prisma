generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled connection (DATABASE_URL) cannot run DDL; migrations need
  // the direct connection. Point both at the same URL for a non-pooled setup.
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum University {
  DIU
  NSU
  AIUB
  BRAC
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum ContestStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
}

enum Verdict {
  AC
  WA
  CE
  RE
  TLE
  MLE
  SKIP
  ERROR
  /// Partial credit — reserved for Phase 3's group/subtask scoring.
  PA
  /// Output limit exceeded — reserved for Phase 3.
  OLE
  /// Judge infrastructure fault (never the submitter's fault); always retried.
  IE
  /// Queued, not yet picked up — reserved for Phase 4's async queue.
  PENDING
  /// A worker has claimed it — reserved for Phase 4's async queue.
  JUDGING
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  name          String
  university    University
  studentId     String?
  department    String?
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  /// Short public blurb on the profile.
  bio           String     @default("")
  /// UI theme id from src/lib/theme.ts, or "system" to follow the OS.
  theme         String     @default("dark")
  /// Monaco editor font size in px (12–20).
  editorFontSize Int       @default(14)
  /// When false, /u/[id] returns 404 to strangers.
  profilePublic Boolean    @default(true)
  /// Show email on the public profile.
  showEmail     Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tokens              AuthToken[]
  submissions         Submission[]
  solvedProblems      SolvedProblem[]
  contestRegs         ContestRegistration[]
  contestsCreated     Contest[]              @relation("ContestCreator")
  adminAuditLogs      AdminAuditLog[]         @relation("AdminAuditActor")

  @@index([university])
  @@index([role])
  @@index([status])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String?
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  actor User @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Contest {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  description     String        @default("")
  status          ContestStatus @default(DRAFT)
  startsAt        DateTime?
  endsAt          DateTime?
  durationMinutes Int           @default(120)
  /// JSON rules: freezeMinutes, penaltyPerWrong, maxSubmissions, languages, visibility, etc.
  rules           Json          @default("{}")
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  createdBy     User                   @relation("ContestCreator", fields: [createdById], references: [id])
  problems      ContestProblem[]
  registrations ContestRegistration[]
  submissions   Submission[]

  @@index([status])
}

model ContestProblem {
  id        String @id @default(cuid())
  contestId String
  problemId String
  order     Int    @default(0)
  points    Int    @default(100)
  label     String @default("A")

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([contestId, problemId])
  @@index([contestId, order])
}

model ContestRegistration {
  id        String   @id @default(cuid())
  contestId String
  userId    String
  createdAt DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
}

model Submission {
  id        String   @id @default(cuid())
  userId    String?
  problemId String
  contestId String?
  code      String
  language  String   @default("c")
  verdict   Verdict
  timeMs    Int?
  stdout    String?
  stderr    String?
  /// Full per-test judge report (all verdicts, times, stdout/stderr per test).
  /// Nullable and additive — Phase 3 normalises the shape into JudgeReport.
  report    Json?
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contest Contest? @relation(fields: [contestId], references: [id], onDelete: SetNull)

  @@index([userId, problemId])
  @@index([contestId, userId])
  @@index([problemId, verdict])
}

model SolvedProblem {
  id           String   @id @default(cuid())
  userId       String
  problemId    String
  firstSolvedAt DateTime @default(now())
  solveCount   Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
  @@index([problemId])
}

/// Per-flag rollout config, resolved by src/lib/flags.ts. Env var
/// FLAGS_<SCREAMING_SNAKE> overrides this row when present.
model FeatureFlag {
  key            String   @id
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(0)
  allowRoles     String[] @default([])
  note           String   @default("")
  updatedAt      DateTime @updatedAt
}

