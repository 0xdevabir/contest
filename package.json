{
  "name": "diu-contesthub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run monaco && next dev",
    "build": "npm run monaco && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "monaco": "node scripts/copy-monaco.mjs",
    "bank:build": "node scripts/build-problem-bank.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push:danger": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run --exclude \"tests/golden/**\"",
    "test:watch": "vitest",
    "test:golden": "vitest run tests/golden",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.0",
    "@sentry/nextjs": "^10.72.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.8",
    "lenis": "^1.3.26",
    "lucide-react": "^1.28.0",
    "monaco-editor": "^0.56.0",
    "next": "15.5.22",
    "nodemailer": "^9.0.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.7",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
