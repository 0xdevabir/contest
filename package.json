{
  "name": "diu-contesthub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run monaco && next dev",
    "build": "npm run monaco && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "monaco": "node scripts/copy-monaco.mjs",
    "bank:build": "node scripts/build-problem-bank.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push:danger": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "worker:dev": "tsx watch worker/src/index.ts",
    "worker:start": "tsx worker/src/index.ts",
    "contest-tick:dev": "tsx watch worker/src/contest-tick.ts",
    "contest-tick:start": "tsx worker/src/contest-tick.ts",
    "standings-tick:dev": "tsx watch worker/src/standings-tick.ts",
    "standings-tick:start": "tsx worker/src/standings-tick.ts",
    "analytics-tick:dev": "tsx watch worker/src/analytics-tick.ts",
    "analytics-tick:start": "tsx worker/src/analytics-tick.ts",
    "ratings-tick:dev": "tsx watch worker/src/ratings-tick.ts",
    "ratings-tick:start": "tsx worker/src/ratings-tick.ts",
    "leaderboard-tick:dev": "tsx watch worker/src/leaderboard-tick.ts",
    "leaderboard-tick:start": "tsx worker/src/leaderboard-tick.ts",
    "notify-worker:dev": "tsx watch worker/src/notify-worker.ts",
    "notify-worker:start": "tsx worker/src/notify-worker.ts",
    "notify-tick:dev": "tsx watch worker/src/notify-tick.ts",
    "notify-tick:start": "tsx worker/src/notify-tick.ts",
    "webhook-worker:dev": "tsx watch worker/src/webhook-worker.ts",
    "webhook-worker:start": "tsx worker/src/webhook-worker.ts",
    "import-worker:dev": "tsx watch worker/src/import-worker.ts",
    "import-worker:start": "tsx worker/src/import-worker.ts",
    "autoscale-tick:dev": "tsx watch worker/src/autoscale-tick.ts",
    "autoscale-tick:start": "tsx worker/src/autoscale-tick.ts",
    "slo-alert-tick:dev": "tsx watch worker/src/slo-alert-tick.ts",
    "slo-alert-tick:start": "tsx worker/src/slo-alert-tick.ts",
    "loadtest": "tsx scripts/loadtest/contest.ts",
    "loadtest:live": "tsx scripts/loadtest/live-contest.ts",
    "seed-load": "tsx scripts/seed-load.ts",
    "test": "vitest run --exclude \"tests/golden/**\"",
    "test:watch": "vitest",
    "test:golden": "vitest run tests/golden",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^10.72.0",
    "@types/web-push": "^3.6.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.2",
    "fast-xml-parser": "^5.11.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "katex": "^0.18.4",
    "lenis": "^1.3.26",
    "lucide-react": "^1.28.0",
    "monaco-editor": "^0.56.0",
    "next": "15.5.22",
    "nodemailer": "^9.0.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unzipper": "^0.12.5",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/unzipper": "^0.10.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "fast-check": "^4.9.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.7",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
