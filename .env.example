# Local Postgres (self-hosted). Same DB for both — DIRECT_URL exists only to
# bypass a connection pooler (e.g. Neon's), which doesn't apply here.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/codehub?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/codehub?schema=public"

# Session signing (generate: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# Public site URL — used for email links, canonical URLs, Open Graph, sitemap,
# and JSON-LD. On your production server set BOTH to your real domain, e.g.:
#   APP_URL="https://codehub.devabir.me"
#   NEXT_PUBLIC_APP_URL="https://codehub.devabir.me"
# NEXT_PUBLIC_APP_URL is preferred for client/SEO surfaces (inlined at build).
# Rebuild the app after changing it since it's inlined, not read at runtime.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP — required for verification and password-reset emails.
# For Gmail: SMTP_USER must be a real Google account, and SMTP_PASS must be a
# 16-character App Password (Google Account → Security → App passwords),
# NOT your normal login password. smtp.gmail.com rejects non-Google usernames.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="CodeHub <you@gmail.com>"

# Interactive runner (see runner/README.md). Enables the live terminal and takes
# over judging. Must be the same token the runner service is started with.
# NEXT_PUBLIC_RUNNER_URL is inlined at build time — redeploy after changing it.
RUNNER_TOKEN=""
NEXT_PUBLIC_RUNNER_URL=""

# Fallback execution backend used when the runner above is not configured.
# Serverless hosts have no C compiler, so a Judge0 instance is used there.
# Defaults to the public instance, which is rate limited and not for production.
# JUDGE0_URL="https://judge0.example.com"
# JUDGE0_KEY=""
# JUDGE0_HOST=""   # only for RapidAPI-hosted Judge0

# Allows the in-process (non-sandboxed) compiler fallback to run in production
# when neither the runner nor Judge0 is configured. Leave unset in production —
# this exists only for constrained self-hosted setups that accept the risk.
# ALLOW_INSECURE_LOCAL_JUDGE="1"

# Anonymous (unauthenticated) concurrent run cap — see src/lib/ratelimit.ts.
ANON_RUN_CONCURRENCY="4"

# Phase 4 judge queue (see docs/phases/DONE__PHASE-04-judge-queue.md). Backs
# the BullMQ queue, SSE pub/sub, and the Redis rate-limit driver. Leave unset
# to keep judging synchronous even when FLAGS_JUDGE_QUEUE=1 — the judge route
# treats "flag on, Redis unset/unreachable" as a clear 503, not a fallback.
# For local dev: `docker compose up redis` then REDIS_URL="redis://localhost:6379".
# REDIS_URL=""

# Shared secret for the worker's HMAC fallback report path
# (POST /api/internal/judge/report) — only needed if a worker can reach
# Redis but not Postgres directly. Generate with: openssl rand -hex 32
# JUDGE_SHARED_SECRET=""

# Judge worker concurrency (worker/src/index.ts) — concurrent judge jobs per
# worker process. Size to the host's sandbox pool capacity, not vCPU count.
# WORKER_CONCURRENCY="4"

# Error tracking (optional). Leave unset to disable Sentry entirely — logging
# still works without it. SENTRY_DSN is server-only; NEXT_PUBLIC_SENTRY_DSN is
# the same DSN inlined into the browser bundle for client-side error capture.
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# Feature flags — env override takes precedence over the FeatureFlag DB table.
# Set to "1" to force-enable, "0" to force-disable. Omit to use the DB/default.
# FLAGS_INSTITUTIONS="0"
# FLAGS_TEACHER_ROLE="0"
# FLAGS_PROBLEM_DB="0"
# FLAGS_JUDGE_V2="0"
# FLAGS_JUDGE_QUEUE="0"
# FLAGS_CLASSROOM="0"
# FLAGS_RATINGS="0"
# FLAGS_INTEGRITY="0"
# FLAGS_SCALE_OPS="0"

# Phase 13 Part 4 — queue-depth worker autoscaling (src/lib/autoscale.ts).
# No Hetzner project is provisioned in this environment; every autoscale code
# path degrades to a logged no-op decision when HETZNER_API_TOKEN is unset,
# so it's safe to leave these commented out.
# HETZNER_API_TOKEN=""
# HETZNER_MAX_WORKERS="5"
# HETZNER_SERVER_TYPE="cx22"
# HETZNER_IMAGE="docker-ce"
# HETZNER_LOCATION="fsn1"

# Phase 13 Part 5 — SLO breach alerting (worker/src/slo-alert-tick.ts). Falls
# back to ADMIN_EMAIL if SLO_ALERT_EMAIL is unset; Telegram alerting no-ops
# with a logged warning if either Telegram var is unset. Neither is
# provisioned in this environment.
# SLO_ALERT_EMAIL=""
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""

# File/image storage (src/lib/blob.ts). This self-hosted setup uses the
# local-filesystem driver — uploads are written to ./.data/blobs on disk.
# Leave BLOB_DRIVER unset (or "fs"); no other vars are needed for it.
# IMPORTANT: if you ever containerize this app, mount a persistent volume at
# .data/blobs — otherwise uploads are lost on every redeploy/restart.
# BLOB_DRIVER="fs"

# Cloudflare R2 (S3-compatible) — only needed if you switch away from local
# storage above. Set BLOB_DRIVER="s3" and all four R2_* vars; getBlobStore()
# throws immediately if it's "s3" with any of these missing.
# BLOB_DRIVER="s3"
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# R2_BUCKET="codehub-blobs"

# Phase 13 Part 6 — read replica for analytics-only queries. Deferred per the
# approved Phase 13 plan (needs a second Postgres instance/connection this
# project hasn't provisioned); see docs/DR.md's "Read replica for analytics"
# section for the wiring point once it exists. Leave unset — no code reads it yet.
# ANALYTICS_DATABASE_URL=""

# Phase 15 — AI intelligence layer (src/lib/ai/). Read by the official
# @anthropic-ai/sdk client (src/lib/ai/client.ts) — required for testgen,
# editorial drafting, variant parameterisation, hints, translation drafts,
# and the nightly recommendation-rationale batch. The "ai" feature flag
# gates every entry point; leaving this unset with the flag off is a safe
# no-op, not a build/runtime error.
# ANTHROPIC_API_KEY="sk-ant-..."

# Required only when running `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-a-strong-password-at-least-12-characters"
ADMIN_NAME="CodeHub Admin"

# Testing only (see tests/setup.ts). CI provides a Postgres service container
# and sets this automatically — you do not need it for `npm run build`/`dev`.
# Locally, point it at a throwaway database on your local Postgres instance.
# Without it, the integration test tier is skipped and only the unit tier runs.
# TEST_DATABASE_URL="postgresql://postgres:test@localhost:5432/codehub_test"

# Neon-only: provisions an ephemeral Neon branch per test run instead of using
# TEST_DATABASE_URL. Not applicable to this self-hosted local-Postgres setup —
# leave unset.
# NEON_API_KEY=""
# NEON_PROJECT_ID=""
