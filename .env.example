# Neon Postgres (pooled connection string recommended)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Session signing (generate: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# Public site URL — used for email links, canonical URLs, Open Graph, sitemap,
# and JSON-LD. On Vercel production set BOTH to your real domain, e.g.:
#   APP_URL="https://diucode.devabir.me"
#   NEXT_PUBLIC_APP_URL="https://diucode.devabir.me"
# NEXT_PUBLIC_APP_URL is preferred for client/SEO surfaces (inlined at build).
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP (Gmail app password, Resend SMTP, Mailgun, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your@email.com"
SMTP_PASS="your-app-password"
SMTP_FROM="DIU ContestHub <noreply@diucontesthub.local>"

# Interactive runner (see runner/README.md). Enables the live terminal and takes
# over judging. Must be the same token the runner service is started with.
# NEXT_PUBLIC_RUNNER_URL is inlined at build time — redeploy after changing it.
RUNNER_TOKEN=""
NEXT_PUBLIC_RUNNER_URL=""

# Fallback execution backend used when the runner above is not configured.
# Serverless hosts have no C compiler, so a Judge0 instance is used there.
# Defaults to the public instance, which is rate limited and not for production.
# JUDGE0_URL="https://judge0.example.com"
# JUDGE0_KEY=""
# JUDGE0_HOST=""   # only for RapidAPI-hosted Judge0

# Required only when running `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-a-strong-password-at-least-12-characters"
ADMIN_NAME="DIU ContestHub Admin"
